{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "alertName":           { "type": "string", "defaultValue": "TempShare-RU-Spike" },
    "cosmosDbAccountName": { "type": "string" },
    "actionGroupName":     { "type": "string", "defaultValue": "TempShare-Alerts" },
    "alertEmail":          { "type": "string" },
    "location":            { "type": "string", "defaultValue": "[resourceGroup().location]" }
  },
  "variables": {
    "cosmosDbResourceId": "[resourceId('Microsoft.DocumentDB/databaseAccounts', parameters('cosmosDbAccountName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/actionGroups",
      "apiVersion": "2023-01-01",
      "name": "[parameters('actionGroupName')]",
      "location": "Global",
      "properties": {
        "groupShortName": "TSAlerts",
        "enabled": true,
        "emailReceivers": [
          {
            "name": "AdminEmail",
            "emailAddress": "[parameters('alertEmail')]",
            "useCommonAlertSchema": true
          }
        ]
      }
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "[parameters('alertName')]",
      "location": "Global",
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
      ],
      "properties": {
        "description": "Fires when Cosmos DB total RU consumption exceeds 500 — potential abuse or viral share event",
        "severity": 2,
        "enabled": true,
        "scopes": [ "[variables('cosmosDbResourceId')]" ],
        "evaluationFrequency": "PT1M",
        "windowSize": "PT5M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "name": "RUSpikeCriterion",
              "metricName": "TotalRequestUnits",
              "metricNamespace": "Microsoft.DocumentDB/databaseAccounts",
              "operator": "GreaterThan",
              "threshold": 500,
              "timeAggregation": "Total",
              "criterionType": "StaticThresholdCriterion"
            }
          ]
        },
        "actions": [
          {
            "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "TempShare-Function-Failures",
      "location": "Global",
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
      ],
      "properties": {
        "description": "Fires when Azure Function TTL cleanup fails — secondary TTL enforcement is down",
        "severity": 1,
        "enabled": true,
        "scopes": [ "[variables('cosmosDbResourceId')]" ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "name": "HighErrorRate",
              "metricName": "TotalRequests",
              "metricNamespace": "Microsoft.DocumentDB/databaseAccounts",
              "operator": "GreaterThan",
              "threshold": 100,
              "timeAggregation": "Total",
              "criterionType": "StaticThresholdCriterion",
              "dimensions": [
                {
                  "name": "StatusCode",
                  "operator": "Include",
                  "values": ["429", "500", "503"]
                }
              ]
            }
          ]
        },
        "actions": [
          {
            "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "TempShare-Storage-Egress",
      "location": "Global",
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
      ],
      "properties": {
        "description": "High blob storage egress — possible viral content or data exfiltration",
        "severity": 3,
        "enabled": true,
        "scopes": [ "[variables('cosmosDbResourceId')]" ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT1H",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "name": "HighEgress",
              "metricName": "TotalRequests",
              "metricNamespace": "Microsoft.DocumentDB/databaseAccounts",
              "operator": "GreaterThan",
              "threshold": 1000,
              "timeAggregation": "Total",
              "criterionType": "StaticThresholdCriterion"
            }
          ]
        },
        "actions": [
          {
            "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
          }
        ]
      }
    }
  ],
  "outputs": {
    "actionGroupId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/actionGroups', parameters('actionGroupName'))]"
    }
  }
}
